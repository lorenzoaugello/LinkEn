ontolex:writtenRep  a  rdf:Property .

rdfs:label  a   rdf:Property .

lila:isHypolemma  a  rdf:Property .

lila:hasPOS  a  rdf:Property .

dcterms:isPartOf  a  rdf:Property .

lila:Hypolemma  a  rdfs:Class .

lila:Lemma  a   rdfs:Class .

lila:adverb a owl:NamedIndividual ;
    a lila:Adverb .
lila:Adverb a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:adjective a owl:NamedIndividual ;
    a lila:Adjective .
lila:Adjective a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:noun a owl:NamedIndividual ;
    a lila:Noun .
lila:Noun a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:verb a owl:NamedIndividual ;
    a lila:Verb .
lila:Verb a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:adposition a owl:NamedIndividual ;
    a lila:Adposition .
lila:Adposition a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:pronoun a owl:NamedIndividual ;
    a lila:Pronoun .
lila:Pronoun a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:interjection a owl:NamedIndividual ;
    a lila:Interjection .
lila:Interjection a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:determiner a owl:NamedIndividual ;
    a lila:Determiner .
lila:Determiner a owl:Class ;
    rdfs:subClassOf lila:POS .

lila:coordinating_conjunction a owl:NamedIndividual ;
    a lila:CoordinatingConjunction .
lila:CoordinatingConjunction a owl:Class ;
    rdfs:subClassOf lila:POS ;
    rdfs:subClassOf lila:Conjunction .

lila:subordinating_conjunction a owl:NamedIndividual ;
    a lila:SubordinatingConjunction .
lila:SubordinatingConjunction a owl:Class ;
    rdfs:subClassOf lila:POS ;
    rdfs:subClassOf lila:Conjunction .

