wnid:oewn-06299854-n a ontolex:LexicalConcept ;
    skos:definition "a word is cognate with another if both derive from the same word in an ancestral language" .

wnid:oewn-06300252-n a ontolex:LexicalConcept ;
    skos:definition "a word formed from two or more words by omitting or combining some sounds" .

wnid:oewn-06300831-n a ontolex:LexicalConcept ;
    skos:definition "(linguistics) a word that is derived from another word" .

wnid:oewn-06301417-n a ontolex:LexicalConcept ;
    skos:definition "the phonological or orthographic sound or appearance of a word that can be used to describe or identify something" .

wnid:oewn-06302383-n a ontolex:LexicalConcept ;
    skos:definition "a word printed at the top of the page of a dictionary or other reference book to indicate the first or last item on that page" .

wnid:oewn-06302780-n a ontolex:LexicalConcept ;
    skos:definition "a word placed at the beginning of a line or paragraph (as in a dictionary entry)" .

wnid:oewn-06302934-n a ontolex:LexicalConcept ;
    skos:definition "a content word that can be qualified by a modifier" .

wnid:oewn-06303617-n a ontolex:LexicalConcept ;
    skos:definition "a word that is more generic than a given word" .

wnid:oewn-06303754-n a ontolex:LexicalConcept ;
    skos:definition "a word that is more specific than a given word" .

wnid:oewn-06304010-n a ontolex:LexicalConcept ;
    skos:definition "a word that is composed of parts from different languages (e.g., ‘monolingual’ has a Greek prefix and a Latin root)" .

wnid:oewn-06304241-n a ontolex:LexicalConcept ;
    skos:definition "a word borrowed from another language; e.g. ‘blitz’ is a German word borrowed into modern English" .

wnid:oewn-06311183-n a ontolex:LexicalConcept ;
    skos:definition "(linguistics) the form of a word after all affixes are removed" .

wnid:oewn-06313371-n a ontolex:LexicalConcept ;
    skos:definition "(grammar) a word that expresses a quantity (as ‘fifteen’ or ‘many’)" .

wnid:oewn-06313532-n a ontolex:LexicalConcept ;
    skos:definition "(logic) a word (such as ‘some’ or ‘all’ or ‘no’) that binds the variables in a logical proposition" .

wnid:oewn-06315049-n a ontolex:LexicalConcept ;
    skos:definition "a system of words used to name things in a particular discipline" .

wnid:oewn-06319426-n a ontolex:LexicalConcept ;
    skos:definition "a word or morpheme used in some languages in certain contexts (such as counting) to indicate the semantic class to which the counted item belongs" .

wnid:oewn-06319755-n a ontolex:LexicalConcept ;
    skos:definition "the end of a word (a suffix or inflectional ending or final morpheme)" .

wnid:oewn-06320674-n a ontolex:LexicalConcept ;
    skos:definition "the class of all items that can be substituted into the same position (or slot) in a grammatical sentence (are in paradigmatic relation with one another)" .

wnid:oewn-06321935-n a ontolex:LexicalConcept ;
    skos:definition "nouns or pronouns or adjectives (often marked by inflection) related in some way to other words in a sentence" .

wnid:oewn-06323757-n a ontolex:LexicalConcept ;
    skos:definition "a construction that can be used to extend the meaning of a word or phrase but is not one of the main constituents of a sentence" .

wnid:oewn-06323956-n a ontolex:LexicalConcept ;
    skos:definition "(grammar) a word or phrase or clause forming part of a larger grammatical construction" .

wnid:oewn-06325134-n a ontolex:LexicalConcept ;
    skos:definition "(grammar) an expression including a subject and predicate functioning as a part of a complex sentence" .

wnid:oewn-06327041-n a ontolex:LexicalConcept ;
    skos:definition "an expression consisting of one or more words forming a grammatical constituent of a sentence" .

wnid:oewn-06327619-n a ontolex:LexicalConcept ;
    skos:definition "one of the two main constituents of a sentence; the predicate contains the verb and its complements" .

wnid:oewn-06327806-n a ontolex:LexicalConcept ;
    skos:definition "(logic) what is predicated of the subject of a proposition; the second term in a proposition is predicated of the first term by means of the copula" .

wnid:oewn-06328855-n a ontolex:LexicalConcept ;
    skos:definition "the word class that can serve as the subject or object of a verb, the object of a preposition, or in apposition" .

wnid:oewn-06329055-n a ontolex:LexicalConcept ;
    skos:definition "the word class that serves as the predicate of a sentence" .

wnid:oewn-06330022-n a ontolex:LexicalConcept ;
    skos:definition "the word class that qualifies nouns" .

wnid:oewn-06330150-n a ontolex:LexicalConcept ;
    skos:definition "the word class that qualifies verbs or clauses" .

wnid:oewn-06330286-n a ontolex:LexicalConcept ;
    skos:definition "a content word that can be used to refer to a person, place, thing, quality, or action" .

wnid:oewn-06331562-n a ontolex:LexicalConcept ;
    skos:definition "a content word that denotes an action, occurrence, or state of existence" .

wnid:oewn-06332695-n a ontolex:LexicalConcept ;
    skos:definition "a word that expresses an attribute of something" .

wnid:oewn-06334277-n a ontolex:LexicalConcept ;
    skos:definition "the superlative form of an adjective or adverb" .

wnid:oewn-06334605-n a ontolex:LexicalConcept ;
    skos:definition "a word that modifies something other than a noun" .

wnid:oewn-06335468-n a ontolex:LexicalConcept ;
    skos:definition "one of a limited class of noun modifiers that determine the referents of noun phrases" .

wnid:oewn-06335662-n a ontolex:LexicalConcept ;
    skos:definition "(grammar) a determiner that may indicate the specificity of reference of a noun phrase" .

wnid:oewn-06336138-n a ontolex:LexicalConcept ;
    skos:definition "a function word that combines with a noun or pronoun or noun phrase to form a prepositional phrase that can have an adverbial or adjectival relation to some other word" .

wnid:oewn-06336819-n a ontolex:LexicalConcept ;
    skos:definition "an uninflected function word that serves to conjoin words or phrases or clauses or sentences" .

wnid:oewn-06337399-n a ontolex:LexicalConcept ;
    skos:definition "a function word that can be used in English to form phrasal verbs" .

wnid:oewn-06337519-n a ontolex:LexicalConcept ;
    skos:definition "the grammatical category for the forms of nouns and pronouns and verbs that are used depending on the number of entities involved (singular or dual or plural)" .

wnid:oewn-06337790-n a ontolex:LexicalConcept ;
    skos:definition "a grammatical category used in the classification of pronouns, possessive determiners, and verb forms according to whether they indicate the speaker, the addressee, or a third party" .

wnid:oewn-06339636-n a ontolex:LexicalConcept ;
    skos:definition "a grammatical category in inflected languages governing the agreement between nouns and pronouns and adjectives; in some languages it is quite arbitrary but in Indo-European languages it is usually based on sex or animateness" .

wnid:oewn-06343357-n a ontolex:LexicalConcept ;
    skos:definition "the semantic role of the animate entity that instigates or causes the happening denoted by the verb in the clause" .

wnid:oewn-06343538-n a ontolex:LexicalConcept ;
    skos:definition "the semantic role of the intended recipient who benefits from the happening denoted by the verb in the clause" .

wnid:oewn-06343724-n a ontolex:LexicalConcept ;
    skos:definition "the semantic role of the entity (usually inanimate) that the agent uses to perform an action or start a process" .

wnid:oewn-06344088-n a ontolex:LexicalConcept ;
    skos:definition "the semantic role of the animate entity that is passively involved in the happening denoted by the verb in the clause" .

