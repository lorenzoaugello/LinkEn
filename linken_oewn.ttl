    skos:definition "something that happens at a given place and time" .

wnid:oewn-00030657-n a ontolex:LexicalConcept ;
    skos:definition "something that people do or cause to happen" .

wnid:oewn-00032220-n a ontolex:LexicalConcept ;
    skos:definition "an abstraction belonging to or characteristic of two entities or parts together" .

wnid:oewn-00032912-n a ontolex:LexicalConcept ;
    skos:definition "anything owned or possessed" .

