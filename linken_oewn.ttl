wnid:oewn-00002137-n a ontolex:LexicalConcept ;
    skos:definition "a general concept formed by extracting common features from specific examples" .

wnid:oewn-00003553-n a ontolex:LexicalConcept ;
    skos:definition "an assemblage of parts that is regarded as a single entity" .

wnid:oewn-00003993-n a ontolex:LexicalConcept ;
    skos:definition "a whole (a thing or person) of the same kind or category as another" .

wnid:oewn-00004475-n a ontolex:LexicalConcept ;
    skos:definition "a living thing that has (or can develop) the ability to act or function independently" .

wnid:oewn-00005930-n a ontolex:LexicalConcept ;
    skos:definition "a plant or animal that is atypically small" .

wnid:oewn-00006150-n a ontolex:LexicalConcept ;
    skos:definition "an organism (plant or animal) from which younger ones are obtained" .

wnid:oewn-00006269-n a ontolex:LexicalConcept ;
    skos:definition "living things collectively" .

wnid:oewn-00006484-n a ontolex:LexicalConcept ;
    skos:definition "(biology) the basic structural and functional unit of all organisms; they may exist as independent units of life (as in monads) or may form colonies or tissues as in higher plants and animals" .

wnid:oewn-00017402-n a ontolex:LexicalConcept ;
    skos:definition "(botany) a living organism lacking the power of locomotion" .

wnid:oewn-00019793-n a ontolex:LexicalConcept ;
    skos:definition "the real physical matter of which a person or thing consists" .

wnid:oewn-00020270-n a ontolex:LexicalConcept ;
    skos:definition "a particular kind or species of matter with uniform properties" .

wnid:oewn-00021914-n a ontolex:LexicalConcept ;
    skos:definition "any substance (such as a chemical element or inorganic compound) that can be taken in by a green plant and used in organic synthesis" .

wnid:oewn-00023083-n a ontolex:LexicalConcept ;
    skos:definition "one of a class of artifacts" .

wnid:oewn-00027365-n a ontolex:LexicalConcept ;
    skos:definition "a point or extent in space; a point or extent in space" .

wnid:oewn-00028950-n a ontolex:LexicalConcept ;
    skos:definition "the unlimited expanse in which everything is located" .

